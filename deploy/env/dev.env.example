# Env template untuk majadu-api DEV instance.
# Salin ke VPS: /srv/qouver/majadu/env/majadu-dev.env (chmod 600).
# JANGAN commit file dengan nilai asli — secret hanya di VPS.

MAJADU_ENV=dev
PORT=8081
MAJADU_DB_SCHEMA=bm_dev
# Ganti CHANGE_ME dengan password role majadu_app; host = nama container
# di network podman "qouver" (bukan 127.0.0.1).
DATABASE_URL=postgres://majadu_app:CHANGE_ME@qouver-postgres:5432/bm_dev
PUBLIC_BASE_URL=https://api.qouver.com/majadu-dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://majadu-dev.vercel.app,https://*.vercel.app
# Log rotasi (app.log, retensi 7 hari) — mount Volume /logs di unit.
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_FILE=/logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_AGE=7
LOG_MAX_BACKUPS=7
LOG_COMPRESS=true