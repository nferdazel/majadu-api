# Salin ke .env untuk dev lokal (jangan commit .env!)
# Kredensial asli hanya di VPS — file ini placeholder.

# dev | prod — prod fail-fast pada config wajib (default: prod)
MAJADU_ENV=dev

# Port HTTP server (default: 8080)
PORT=8080

# Koneksi Postgres (WAJIB).
# Contoh: postgres://user:pass@localhost:5432/bm_dev
DATABASE_URL=

# Schema Postgres target — WAJIB (bukan hardcode, aman untuk merge dev→main).
# Dev: bm_dev · Prod: bm
MAJADU_DB_SCHEMA=bm_dev

# Origin frontend yang diizinkan (comma-separated).
# Dev: boleh "*". Prod: WAJIB daftar eksplisit, mis. https://app.example.com
CORS_ALLOWED_ORIGINS=*

# URL publik API — dipakai untuk header Location. Kosong = relative path.
# Prod: https://api.qouver.com/majadu
PUBLIC_BASE_URL=

# Rate limit per menit per IP (token bucket). 0 = disabled. Default 120.
MAJADU_RATE_LIMIT_PER_MIN=120

# ── LOGGING ───────────────────────────────────────────────────────────
# Level logging: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Format log: text | json (default: text)
LOG_FORMAT=text

# Target file log. Kosong = stdout saja (default dev). Misal: /logs/app.log atau ./app.log
LOG_FILE=

# Ukuran maksimal per file dalam MB sebelum dirotasi (default: 100)
LOG_MAX_SIZE=100

# Retensi file log lama dalam hari (default: 7)
LOG_MAX_AGE=7

# Jumlah maksimal file cadangan log yang disimpan (default: 7)
LOG_MAX_BACKUPS=7

# Kompresi gzip untuk file cadangan log (default: true)
LOG_COMPRESS=true
